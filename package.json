{
  "name": "stremio-accru",
  "version": "0.1.0",
  "description": "Platform-agnostic Stremio-Kai (Tauri + stremio-core + MPV)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm run test:rust && npm run test:frontend && npm run build && npm run check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-store": "^2.1.0",
    "@tauri-apps/plugin-updater": "^2.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.16.0",
    "@sveltejs/vite-plugin-svelte": "4.0.4",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/svelte": "^5.0.0",
    "@types/node": "^26.4.1",
    "jsdom": "^24.0.0",
    "svelte": "5.28.0",
    "svelte-check": "4.0.8",
    "typescript": "5.5.4",
    "vite": "5.4.19",
    "vitest": "^1.4.0"
  }
}
