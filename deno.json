{
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "deno task test:rust && deno task test && deno task build && deno task check"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["src/"]
  }
}
