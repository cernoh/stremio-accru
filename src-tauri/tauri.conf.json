{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "app": {
    "productName": "Stremio Accru",
    "version": "0.1.0",
    "identifier": "com.stremio.accru",
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["../portable_config", "../resources"]
  },
  "plugins": {
    "updater": { "pubkey": "", "endpoints": ["https://github.com/cernoh/stremio-accru/releases/latest/download/latest.json"] },
    "store": {}
  }
}
